<?xml version="1.0" encoding="utf-8"?>
<!-- One dua: heading, the Arabic text (always Cairo, right-to-left), a short note, and Mark as read. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_z_card"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/dua_title"
        style="@style/Z.RowTitle"
        android:textColor="@color/brand_orange" />

    <TextView
        android:id="@+id/dua_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/cairo_semibold"
        android:lineSpacingMultiplier="1.35"
        android:textColor="@color/text_primary"
        android:textDirection="rtl"
        android:textIsSelectable="true"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/dua_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/cairo_semibold"
        android:textColor="@color/text_secondary"
        android:textDirection="rtl"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dua_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_z_outline_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
