<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/splash_words"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/splash_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_extrabold_italic"
            android:includeFontPadding="false"
            android:text="@string/z_brand"
            android:textColor="@color/text_primary"
            android:textDirection="ltr"
            android:textSize="96sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/cairo_semibold"
            android:text="@string/z_basmala"
            android:textColor="#D4D4D8"
            android:textSize="20sp" />
    </LinearLayout>

    <com.z150x.app.RideStripView
        android:id="@+id/splash_strip"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="64dp"
        android:importantForAccessibility="no" />
</LinearLayout>
