<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView style="@style/Z.Scroll">

    <LinearLayout style="@style/Z.ScrollBody">

    <TextView
        android:id="@+id/ob_lang_title"
        style="@style/Z.Title"
        android:text="@string/z_ob_lets_ride" />

    <TextView
        style="@style/Z.Sub"
        android:text="@string/z_ob_pick_lang" />

    <LinearLayout
        android:id="@+id/ob_lang_ar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@drawable/bg_z_lang_red"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="120dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo_extrabold"
            android:text="@string/z_ob_arabic"
            android:textColor="@color/white"
            android:textSize="@dimen/z_lang_size" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/z_ob_arabic_sub"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ob_lang_en"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_z_lang_big"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="120dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_extrabold_italic"
            android:text="@string/z_ob_english"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/z_lang_size" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo_semibold"
            android:text="@string/z_ob_english_sub"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/z_ob_lang_hint"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
