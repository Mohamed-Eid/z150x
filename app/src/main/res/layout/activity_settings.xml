<?xml version="1.0" encoding="utf-8"?>
<!-- Z150X Settings: only what a rider needs; everything else (recommended defaults) lives in
     Advanced settings (SetupActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/set_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Z.Title"
            android:layout_marginTop="12dp"
            android:text="@string/z_nav_settings" />

        <!-- Dash -->
        <TextView style="@style/Z.Section" android:text="@string/z_set_dash" />
        <LinearLayout style="@style/Z.Card">

            <LinearLayout android:id="@+id/set_fit" style="@style/Z.SetRow" android:clickable="true" android:focusable="true">
                <LinearLayout style="@style/Z.RowText">
                    <TextView style="@style/Z.RowTitle" android:text="@string/z_set_fit" />
                    <TextView style="@style/Z.RowSub" android:text="@string/z_set_fit_sub" />
                </LinearLayout>
                <ImageView style="@style/Z.Chevron" />
            </LinearLayout>

            <View style="@style/Z.Divider" />

            <LinearLayout style="@style/Z.SetRow">
                <LinearLayout style="@style/Z.RowText">
                    <TextView style="@style/Z.RowTitle" android:text="@string/z_set_safe" />
                    <TextView style="@style/Z.RowSub" android:text="@string/z_set_safe_sub" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/set_safe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/z_set_safe" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/set_safe_sliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView style="@style/Z.RowSub" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_set_top" />
                    <TextView android:id="@+id/set_top_val" style="@style/Z.RowSub" android:layout_width="wrap_content" android:textDirection="ltr" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/set_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/z_set_top" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView style="@style/Z.RowSub" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_set_bottom" />
                    <TextView android:id="@+id/set_bottom_val" style="@style/Z.RowSub" android:layout_width="wrap_content" android:textDirection="ltr" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/set_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/z_set_bottom" />
            </LinearLayout>

            <View style="@style/Z.Divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/Z.RowTitle" android:text="@string/z_set_layout" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="-4dp"
                    android:layout_marginEnd="-4dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/set_layout_split" style="@style/Z.Seg" android:text="@string/z_set_layout_split" />
                    <TextView android:id="@+id/set_layout_full" style="@style/Z.Seg" android:text="@string/z_set_layout_full" />
                </LinearLayout>
                <TextView style="@style/Z.RowSub" android:layout_marginTop="8dp" android:text="@string/z_set_next_connect" />
            </LinearLayout>

            <View style="@style/Z.Divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/Z.RowTitle" android:text="@string/z_set_colors" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="-4dp"
                    android:layout_marginEnd="-4dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/set_theme_auto" style="@style/Z.Seg" android:text="@string/z_set_auto" />
                    <TextView android:id="@+id/set_theme_day" style="@style/Z.Seg" android:text="@string/z_set_day" />
                    <TextView android:id="@+id/set_theme_night" style="@style/Z.Seg" android:text="@string/z_set_night" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Connection -->
        <TextView style="@style/Z.Section" android:text="@string/z_set_connection" />
        <LinearLayout style="@style/Z.Card">
            <LinearLayout style="@style/Z.SetRow">
                <LinearLayout style="@style/Z.RowText">
                    <TextView style="@style/Z.RowTitle" android:text="@string/z_set_auto_connect" />
                    <TextView style="@style/Z.RowSub" android:text="@string/z_set_auto_connect_sub" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/set_auto_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/z_set_auto_connect" />
            </LinearLayout>
        </LinearLayout>

        <!-- Riding -->
        <TextView style="@style/Z.Section" android:text="@string/z_set_riding" />
        <LinearLayout style="@style/Z.Card">
            <LinearLayout style="@style/Z.SetRow">
                <LinearLayout style="@style/Z.RowText">
                    <TextView style="@style/Z.RowTitle" android:text="@string/z_set_duas" />
                    <TextView style="@style/Z.RowSub" android:text="@string/z_set_duas_sub" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/set_duas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/z_set_duas" />
            </LinearLayout>
            <LinearLayout android:id="@+id/set_duas_open" style="@style/Z.SetRow" android:clickable="true" android:focusable="true">
                <TextView style="@style/Z.RowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_set_duas_open" />
                <ImageView style="@style/Z.Chevron" />
            </LinearLayout>
            <View style="@style/Z.Divider" />
            <LinearLayout android:id="@+id/set_controls" style="@style/Z.SetRow" android:clickable="true" android:focusable="true">
                <LinearLayout style="@style/Z.RowText">
                    <TextView style="@style/Z.RowTitle" android:text="@string/z_controls" />
                    <TextView style="@style/Z.RowSub" android:text="@string/z_controls_sub" />
                </LinearLayout>
                <ImageView style="@style/Z.Chevron" />
            </LinearLayout>
            <View style="@style/Z.Divider" />
            <LinearLayout style="@style/Z.SetRow">
                <TextView style="@style/Z.RowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_set_log_rides" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/set_log_rides"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/z_set_log_rides" />
            </LinearLayout>
            <View style="@style/Z.Divider" />
            <LinearLayout style="@style/Z.SetRow">
                <LinearLayout style="@style/Z.RowText">
                    <TextView style="@style/Z.RowTitle" android:text="@string/z_set_name_rides" />
                    <TextView style="@style/Z.RowSub" android:text="@string/z_set_name_rides_sub" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/set_name_rides"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/z_set_name_rides" />
            </LinearLayout>
            <View style="@style/Z.Divider" />
            <LinearLayout style="@style/Z.SetRow">
                <TextView style="@style/Z.RowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_set_parking" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/set_parking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/z_set_parking" />
            </LinearLayout>
            <View style="@style/Z.Divider" />
            <LinearLayout style="@style/Z.SetRow">
                <TextView style="@style/Z.RowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_set_rain" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/set_rain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/z_set_rain" />
            </LinearLayout>
        </LinearLayout>

        <!-- App -->
        <TextView style="@style/Z.Section" android:text="@string/z_set_app" />
        <LinearLayout style="@style/Z.Card">
            <LinearLayout android:id="@+id/set_language" style="@style/Z.SetRow" android:clickable="true" android:focusable="true">
                <TextView style="@style/Z.RowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_set_language" />
                <TextView style="@style/Z.RowSub" android:layout_width="wrap_content" android:layout_marginEnd="8dp" android:text="@string/z_set_language_value" />
                <ImageView style="@style/Z.Chevron" />
            </LinearLayout>
            <View style="@style/Z.Divider" />
            <LinearLayout android:id="@+id/set_share_log" style="@style/Z.SetRow" android:clickable="true" android:focusable="true">
                <TextView style="@style/Z.RowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_share_log" />
                <ImageView style="@style/Z.Chevron" />
            </LinearLayout>
            <View style="@style/Z.Divider" />
            <LinearLayout android:id="@+id/set_about" style="@style/Z.SetRow" android:clickable="true" android:focusable="true">
                <TextView style="@style/Z.RowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/z_set_about" />
                <ImageView style="@style/Z.Chevron" />
            </LinearLayout>
            <View style="@style/Z.Divider" />
            <LinearLayout android:id="@+id/set_advanced" style="@style/Z.SetRow" android:clickable="true" android:focusable="true">
                <LinearLayout style="@style/Z.RowText">
                    <TextView style="@style/Z.RowTitle" android:text="@string/z_set_advanced" />
                    <TextView style="@style/Z.RowSub" android:text="@string/z_set_advanced_sub" />
                </LinearLayout>
                <ImageView style="@style/Z.Chevron" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
